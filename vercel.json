{
  "redirects": [
    {
      "source": "/:path(.*)",
      "destination": "https://readershall.com/:path",
      "statusCode": 301
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 8 * * 0"
    },
    {
      "path": "/api/cron/inactivity",
      "schedule": "0 9 * * *"
    }
  ]
}
